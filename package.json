{
  "name": "avo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-service-worker.mjs",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check:dependencies && npm run test:dependencies && npm run format:check && npm run lint && npm run typecheck && npm test && npm run db:check && npm run check:tasks",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "test:dependencies": "node --test scripts/check-dependencies.test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postgres": "vitest run --config vitest.postgres.config.mts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts development",
    "db:migrate:prod": "tsx --conditions=react-server scripts/db-migrate.ts production",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio --config drizzle.migrate.config.ts",
    "db:health": "tsx --conditions=react-server scripts/db-health.ts",
    "db:health:prod": "tsx --conditions=react-server scripts/db-health.ts .env.prod",
    "db:verify": "tsx --conditions=react-server scripts/db-verify.ts",
    "db:verify:prod": "tsx --conditions=react-server scripts/db-verify.ts .env.prod",
    "check:tasks": "node scripts/check-tasks.mjs",
    "test:tasks": "node --test scripts/check-tasks.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "1.7.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vercel/functions": "^3.10.5",
    "better-auth": "1.7.15",
    "dexie": "^4.4.7",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.7",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "npm@11.20.0"
}
