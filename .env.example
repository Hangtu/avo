# Runtime: Neon pooled connection (hostname includes -pooler).
# Never commit .env.local or expose this value to the browser.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/runo?sslmode=require&channel_binding=require"

# Drizzle Kit: Neon direct connection (no -pooler) for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/runo?sslmode=require&channel_binding=require"

# Single-user identity until authentication lands.
RUNO_OWNER_ID="owner"
RUNO_TIME_ZONE="America/Mexico_City"
