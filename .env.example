# Entornos: `.env` = desarrollo (`npm run db:migrate`) y `.env.prod` = producción
# (`npm run db:migrate:prod`, solo DATABASE_URL_UNPOOLED y conexión directa sin -pooler).
# Ambos están ignorados por git. Esta plantilla corresponde a `.env`.

# Runtime: Neon pooled connection (hostname includes -pooler).
# Never commit .env or expose this value to the browser.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/runo?sslmode=verify-full&channel_binding=require"

# Drizzle Kit: Neon direct connection (no -pooler) for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/runo?sslmode=verify-full&channel_binding=require"

# Better Auth (E4). Generate a real secret with: openssl rand -base64 32
# Production: planned domain is https://avo.frutit.app/ (not yet configured).
# Set BETTER_AUTH_URL to its exact HTTPS origin: https://avo.frutit.app
# Better Auth trusts this base origin automatically; no extra origin list is needed.
BETTER_AUTH_SECRET="genera-32-bytes-aleatorios-con-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Optional exact LAN hostnames for Next dev/HMR only (no scheme, port or wildcard).
# Opt in locally after removing the old hardcoded host; empty means localhost only.
# Example: AVO_DEV_HOSTS="192.0.2.10"
AVO_DEV_HOSTS=""

# Optional exact origins for LAN auth/sync, honored ONLY under NODE_ENV=development.
# HMR allowedDevOrigins alone does not authorize authentication. Register provider callbacks separately.
# Example: AVO_DEV_AUTH_ORIGINS="http://192.168.68.109:3000"
AVO_DEV_AUTH_ORIGINS=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Vercel sets VERCEL=1 automatically. Only there is x-vercel-forwarded-for trusted
# for rate limits. Do not spoof/set this locally; other hosts use a shared IP bucket
# until their trusted reverse-proxy boundary is explicitly reviewed.

# Canonical origin for metadata, robots, and sitemap. Optional locally and in
# preview; set it to the exact HTTPS origin before production
# (https://avo.frutit.app). On Vercel the production host is used as fallback.
NEXT_PUBLIC_SITE_URL=""

# Optional real PostgreSQL concurrency suite: it NEVER reads this file.
# Pass both variables explicitly in the shell, only for a fresh approved local DB.
# Do not point a loopback port at a tunnel to Neon or use application credentials.
# AVO_ALLOW_LOCAL_POSTGRES_TESTS=1
# AVO_TEST_DATABASE_URL="postgresql://avo_test:SYNTHETIC_PASSWORD@127.0.0.1:65432/avo_test_resilience"

# Legal controller identity. Confirm these details before publishing.
# Support/privacy email is fixed to support@frutit.app in lib/legal.ts.
NEXT_PUBLIC_PRIVACY_CONTROLLER_NAME=""
NEXT_PUBLIC_PRIVACY_CONTROLLER_ADDRESS=""
